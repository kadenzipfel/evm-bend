def alice() -> W.Word: W.W{4097,0,0,0,0,0,0,0}
def bob() -> W.Word: W.W{4098,0,0,0,0,0,0,0}
def contract() -> W.Word: W.W{12288,0,0,0,0,0,0,0}
def slot_alice() -> W.Word: W.W{2330010872,3703262715,1677944950,3740353419,3678551145,4118846448,2646440995,3334469682}
def slot_bob() -> W.Word: W.W{3923311578,2509928126,2845221683,479847589,4132385688,440257379,4109571125,2715105625}
def supply() -> W.Word: W.W{1000000,0,0,0,0,0,0,0}

def world0() -> M.World:
  +slots = {[M.Slot{slot_alice(), supply()}, M.Slot{W.from_u32(2), supply()}] : +List<M.Slot>}
  +c = M.Account.set_exists(M.Account.set_original(M.Account.set_storage(
        M.Account.set_code(M.empty_account(contract()), code()), slots), slots), True{})
  +a = M.Account.set_exists(M.Account.set_balance(M.empty_account(alice()), supply()), True{})
  World.put(World.put(M.empty_world(), c), a)

def calldata(to: W.Word, amount: W.Word) -> +List<U32>:
  B.concat([169,5,156,187], B.concat(B.from_word(to), B.from_word(amount)))

def tx(data: +List<U32>) -> T.Transaction:
  T.Tx{0, alice(), W.zero(), U32.to_nat(1000000), Some{contract()}, W.zero(), data,
      None{}, W.zero(), W.zero(), W.zero(), Nil{}, Nil{}, Nil{}}

# Self-recursive only: Bend rejects mutual recursion, so the termination test
# arrives as a parameter (a match cannot scrutinize a computed value).
def drive(fuel: Nat, done: Bool, m: M.Machine) -> M.Machine:
  match fuel:
    case 0n: m
    case 1n+f:
      match done:
        case True{}: m
        case False{}:
          +next = VM.step(m)
          drive(f, VM.finished(next), next)

def run(m: M.Machine) -> M.Machine:
  drive(U32.to_nat(400000), False{}, m)

def balance_of(w: M.World, key: W.Word) -> W.Word:
  World.lookup(M.Account.storage(World.account(w, contract())), key)

def settled_world(mw: +Maybe<M.World>) -> W.Word:
  match mw:
    case None{}: W.from_u32(111111)
    case Some{w}: balance_of(w, slot_bob())

def settled(c: Tx.Completion) -> W.Word:
  settled_world(Tx.Completion.world(c))

def prepared(p: Tx.Preparation) -> W.Word:
  match p:
    case Tx.Rejected{reason}: W.from_u32(222222)
    case Tx.Prepared{engine, metadata}:
      settled(Tx.finish(metadata, M.Machine.engine(run(M.Machine{engine, Nil{}}))))

# One full transfer of `amount` from alice to bob, returning bob's new balance.
def once(amount: W.Word) -> W.Word:
  prepared(Tx.prepare(tx(calldata(bob(), amount)), world0(), M.default_context()))

# N distinct transfers -- the amount varies per iteration so nothing is shared.
def bench(n: Nat, acc: W.Word) -> W.Word:
  match n:
    case 0n: acc
    case 1n+p:
      +q = p
      bench(q, W.add(acc, once(W.add(O.from_nat(q), W.from_u32(1)))))

def action_of(p: Tx.Preparation) -> String:
  match p:
    case Tx.Rejected{reason}: "REJECTED " ++ U32.show(reason)
    case Tx.Prepared{engine, metadata}:
      R.status(M.Frame.action(M.Engine.frame(M.Machine.engine(
        run(M.Machine{engine, Nil{}})))))

def output_of(p: Tx.Preparation) -> String:
  match p:
    case Tx.Rejected{reason}: "rejected"
    case Tx.Prepared{engine, metadata}:
      R.bytes(M.Frame.output(M.Engine.frame(M.Machine.engine(run(M.Machine{engine, Nil{}})))))

def probe_prep(p: Tx.Preparation) -> String:
  match p:
    case Tx.Rejected{reason}: "rejected " ++ U32.show(reason)
    case Tx.Prepared{engine, metadata}:
      +f = M.Engine.frame(M.Machine.engine(run(M.Machine{engine, Nil{}})))
      R.status(M.Frame.action(f)) ++ " gas=" ++ Nat.show(M.Frame.gas(f)) ++ " reason=" ++ U32.show(R.reason(M.Frame.action(f))) ++ " out=" ++ R.bytes(M.Frame.output(f))

def probe(data: +List<U32>) -> String:
  probe_prep(Tx.prepare(tx(data), world0(), M.default_context()))

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print("sanity  : " ++ probe(calldata(bob(), W.from_u32(7))))
    IO.print("bob@7   : " ++ W.show(once(W.from_u32(7))))
    IO.print("bench100: " ++ W.show(bench(U32.to_nat(100), W.zero())))
